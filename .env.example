# Plantilla de variables locales. Copia este archivo a `.env` y rellena los
# valores. `.env` está en .gitignore y nunca debe subirse al repositorio.

# Google Drive (Biblioteca de proyectos, solo lectura)
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# Google Sign-In (opcional: el proyecto ya trae un valor por defecto)
# Cliente OAuth Web de Firebase. Solo hace falta si usas otro proyecto.
GOOGLE_SERVER_CLIENT_ID=
# Cliente OAuth iOS/macOS (opcional).
GOOGLE_IOS_CLIENT_ID=
