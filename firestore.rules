rules_version = '2';

// Reglas de Firestore para TuEstadia.
//
// Lectura pública del contenido (feed, biblioteca y foro) y escritura solo para
// usuarios autenticados. El perfil y la biblioteca personal solo los escribe su
// dueño.
//
// Para aplicarlas:
//   Firebase Console > Firestore Database > Rules > pega este contenido > Publish
// (o `firebase deploy --only firestore:rules` si usas Firebase CLI).
//
// ── Verificación de correo (preparada) ────────────────────────────────────────
// Ahora mismo el registro es inmediato y no se exige confirmar el correo, así
// que las escrituras piden solo `request.auth != null`.
//
// Cuando actives `AuthConfig.requireEmailVerification`, puedes endurecer las
// reglas añadiendo a cada `allow write` la condición:
//
//   && request.auth.token.email_verified == true
//
// Sin esa condición, un usuario podría saltarse la pantalla de verificación
// llamando directamente a la API; con ella, Firestore también lo bloquea.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Proyectos (feed legacy) ────────────────────────────────────────────
    match /projects/{projectId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      // El autor edita todo; el resto solo puede guardar/quitar de guardados.
      allow update: if request.auth != null
                    && (resource.data.authorId == request.auth.uid
                        || request.resource.data
                             .diff(resource.data)
                             .affectedKeys()
                             .hasOnly(['saved', 'savedBy']));
      allow delete: if request.auth != null
                    && resource.data.authorId == request.auth.uid;
    }

    // ── Pines del feed (Pinterest) ─────────────────────────────────────────
    match /pins/{pinId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      // Guardar un pin ajeno es un update que SOLO toca `savedBy`.
      allow update: if request.auth != null
                    && (resource.data.authorId == request.auth.uid
                        || request.resource.data
                             .diff(resource.data)
                             .affectedKeys()
                             .hasOnly(['savedBy']));
      allow delete: if request.auth != null
                    && resource.data.authorId == request.auth.uid;
    }

    // ── Biblioteca personal (archivos de Drive asignados) ──────────────────
    match /libraryItems/{itemId} {
      allow read: if request.auth != null
                  && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.ownerId == request.auth.uid;
    }

    // ── Cursos y capítulos ─────────────────────────────────────────────────
    match /courses/{courseId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /chapters/{chapterId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Foro ──────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if true;
      // Solo se puede publicar a nombre propio: el post debe llevar tu uid.
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      // El autor puede editar su post; el resto solo puede tocar los campos
      // de interacción (likes, guardados, vistas, respuestas y votos).
      allow update: if request.auth != null
                    && (resource.data.authorId == request.auth.uid
                        || request.resource.data
                             .diff(resource.data)
                             .affectedKeys()
                             .hasOnly([
                               'likes', 'likedBy', 'saved', 'savedBy',
                               'views', 'replies', 'poll',
                             ]));
      allow delete: if request.auth != null
                    && resource.data.authorId == request.auth.uid;
    }

    // ── Perfiles ──────────────────────────────────────────────────────────
    match /profiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
